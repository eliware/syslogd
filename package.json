{
  "name": "@eliware/syslog",
  "version": "1.0.0",
  "description": "MySQL-backed syslog collector in Node.js.",
  "keywords": [
    "syslog",
    "logging",
    "mysql",
    "log-collector",
    "nodejs"
  ],
  "type": "module",
  "main": "syslog.mjs",
  "scripts": {
    "start": "node syslog.mjs",
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent --runInBand",
    "lint": "npx oxlint . --ignore-pattern 'node_modules/**'"
  },
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "jest": "^30.0.4",
    "oxlint": "^1.74.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "eliware": {
    "id": "E-1380",
    "apply": ["general", "application", "ghcr-published"]
  }
}
